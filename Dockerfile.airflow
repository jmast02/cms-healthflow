FROM apache/airflow:2.9.0

USER root

# Java required for PySpark jobs run directly by Airflow
RUN apt-get update && apt-get install -y --no-install-recommends \
    default-jre-headless \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# PostgreSQL JDBC driver for Spark → PostgreSQL writes
RUN curl -fsSL https://jdbc.postgresql.org/download/postgresql-42.7.3.jar \
    -o /opt/postgresql-jdbc.jar

ENV JAVA_HOME=/usr/lib/jvm/default-java
ENV PYSPARK_PYTHON=python3

USER airflow

# Spark + data deps — intentionally excludes FastAPI/SQLAlchemy 2.x
# to avoid conflicting with Airflow's SQLAlchemy < 2.0 requirement
RUN pip install --no-cache-dir \
    pyspark==3.5.1 \
    pyarrow==16.1.0 \
    pandas==2.2.2 \
    psycopg2-binary==2.9.9 \
    minio==7.2.7 \
    boto3==1.34.131 \
    great-expectations==0.18.16 \
    tqdm==4.66.4 \
    requests==2.31.0 \
    python-dotenv==1.0.1
