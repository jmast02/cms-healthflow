# ── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433   # host port (Docker maps 5433→5432 inside the container)
POSTGRES_DB=cms_healthflow
POSTGRES_USER=healthflow
POSTGRES_PASSWORD=healthflow_secret

# ── MinIO (Local S3) ─────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_RAW=cms-raw
MINIO_BUCKET_PARQUET=cms-parquet

# ── Spark ─────────────────────────────────────────────────────────────────
SPARK_MASTER=local[*]
SPARK_APP_NAME=cms-healthflow
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=2g

# ── API ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ── CMS Data ─────────────────────────────────────────────────────────────
# Primary dataset: Medicare Physician/Other Practitioners by Provider and Service
CMS_PROVIDER_DATASET_YEAR=2022
CMS_DATA_DIR=data/raw
